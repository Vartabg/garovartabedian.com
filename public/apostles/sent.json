  "armenia": {
    "title": "Why Armenia keeps two of these names",
    "text": "The Armenian Apostolic Church traces itself to Thaddaeus and Bartholomew and calls them its first illuminators — the claim in its name. The written sources are 5th-century national histories carrying older memory, and this site grades them accordingly: tradition, stated as tradition. What is plain history is what the tradition grew into — Gregory the Illuminator's mission, and in 301 the first kingdom on earth to make Christianity its state faith.",
    "seeAlso": {
      "href": "/church/faces",
      "label": "Gregory the Illuminator, in the faces"
    }
  },
